# ==============================================================
# AIRA Virtual Human — Environment Configuration Template
# DO NOT COMMIT ACTUAL API KEYS OR SECRETS TO SOURCE CONTROL
# ==============================================================

# --------------------------------------------------------------
# BACKEND SERVER CONFIGURATION (Configure in Render Web Service Dashboard)
# --------------------------------------------------------------

# GEMINI_API_KEY: (MANDATORY) Google Gemini API key for real-time voice (gemini-3.8-live)
GEMINI_API_KEY="your_gemini_api_key_here"

# WEATHER_API_KEY: (OPTIONAL) OpenWeatherMap API key for live real-time weather reports
WEATHER_API_KEY="your_openweather_api_key_here"

# PORT: Server port (Render sets this automatically; defaults to 3001 locally)
PORT=3001

# APP_URL: Public URL of your deployed Render service (e.g. https://aira-backend.onrender.com)
APP_URL="http://localhost:3001"

# TIMEZONE: Fallback timezone for grounding conversational clock (e.g. Asia/Kolkata, America/New_York)
TIMEZONE="Asia/Kolkata"

# FRONTEND_URL: Allowed Vercel frontend origin for CORS (e.g. https://your-aira.vercel.app)
FRONTEND_URL="http://localhost:5173"

# --------------------------------------------------------------
# FRONTEND CONFIGURATION (Configure in Vercel Project Settings > Environment Variables)
# --------------------------------------------------------------

# VITE_WS_URL: (MANDATORY ON VERCEL) Full WebSocket URL of your deployed Render backend
# Examples:
#   wss://aira-backend.onrender.com/live
#   https://aira-backend.onrender.com
# Leave empty for local development to automatically connect to localhost:3001
VITE_WS_URL=""
