# ==============================================================
# AIRA Virtual Human — Environment Configuration Template
# DO NOT COMMIT ACTUAL API KEYS OR SECRETS TO SOURCE CONTROL
# ==============================================================

# Backend Server Secrets (Configure in Render / Railway / Cloud Run or local .env)
# ---------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key required for Gemini Live bidirectional voice (gemini-3.8-live)
GEMINI_API_KEY="your_gemini_api_key_here"

# WEATHER_API_KEY: OpenWeatherMap API key for live real-time weather reports
WEATHER_API_KEY="your_openweather_api_key_here"

# Server Port (defaults to 3001 if omitted)
PORT=3001

# Application URL for deployed origin reference
APP_URL="http://localhost:3001"

# Timezone fallback for conversational timestamp grounding (e.g. Asia/Kolkata, America/New_York)
TIMEZONE="Asia/Kolkata"

# Frontend Configuration (Configure in Vercel Project Settings > Environment Variables)
# ---------------------------------------------------------------------------------
# VITE_WS_URL: WebSocket URL of your deployed Render backend (e.g. wss://aira-backend.onrender.com).
# Leave empty for local development to automatically connect to localhost:3001.
VITE_WS_URL=""
